# ==============================================================================
# HE THONG QUAN LY DAT BAN VA GOI MON TRUC TUYEN - NHA HANG BEP VIET
# Tep bien moi truong mau (.env.example)
# Sao chep tep nay thanh .env va dien thong tin thuc te cua ban:
# cp .env.example .env (hoac copy .env.example .env tren Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CO SO DU LIEU (DATABASE CONFIGURATION)
# ------------------------------------------------------------------------------
# Tuy chon A: Mac dinh dung H2 in-memory tu dong tao bang (Khong can cai dat MySQL)
# De trong cac dong duoi day hoac giu nguyen de he thong tu khoi chay H2 MySQL mode.
# DB_URL=jdbc:h2:mem:restaurant_db;DB_CLOSE_DELAY=-1;MODE=MySQL
# DB_USERNAME=sa
# DB_PASSWORD=
# DB_DRIVER=org.h2.Driver

# Tuy chon B: Ket noi MySQL cuc bo (Localhost)
# DB_URL=jdbc:mysql://localhost:3306/restaurant_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
# DB_USERNAME=root
# DB_PASSWORD=your_mysql_password
# DB_DRIVER=com.mysql.cj.jdbc.Driver

# Tuy chon C: Ket noi Database Cloud mien phi (Aiven / Clever Cloud / Railway / TiDB)
# Vi du Aiven MySQL:
# DB_URL=jdbc:mysql://mysql-doanj2ee-project.aivencloud.com:12345/defaultdb?sslmode=require&allowPublicKeyRetrieval=true
# DB_USERNAME=avnadmin
# DB_PASSWORD=your_aiven_password
# DB_DRIVER=com.mysql.cj.jdbc.Driver

# ------------------------------------------------------------------------------
# 2. XAC THUC & BAO MAT (JWT SECRET CONFIGURATION)
# ------------------------------------------------------------------------------
# Chuoi bi mat dung chung de ky va xac thuc JWT Token cho ca 3 Microservices (toi thieu 32 ky tu)
JWT_SECRET=DoAnJ2EE_SuperSecretKey_For_Jwt_Authentication_2026_Minimum32Bytes
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# 3. DANG NHAP GOOGLE OAUTH2 (GOOGLE SIGN-IN)
# ------------------------------------------------------------------------------
# Client ID lay tu Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=610122029992-9avsfbips2dr983jvfjfkvcchkr2jluk.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=610122029992-9avsfbips2dr983jvfjfkvcchkr2jluk.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. CONG THANH TOAN TRUC TUYEN VNPAY (VNPAY SANDBOX)
# ------------------------------------------------------------------------------
# Thong so ket noi cong thanh toan VNPAY Sandbox (Test)
VNPAY_TMN_CODE=DEMOV210
VNPAY_HASH_SECRET=RAOEXHYVSDDIIENYWSLDIIZTANXUXZFJ
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return

# ------------------------------------------------------------------------------
# 5. DICH VU LUU TRU ANH DAM MAY CLOUDINARY (IMAGE STORAGE)
# ------------------------------------------------------------------------------
# Dang ky tai khoan mien phi tai https://cloudinary.com de lay Cloud Name, API Key va API Secret
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 6. GUI EMAIL XAC NHAN DAT BAN (GMAIL SMTP / SPRING MAIL)
# ------------------------------------------------------------------------------
# Su dung Gmail SMTP voi Mat khau ung dung (App Password 16 ky tu cua Google):
# Huong dan tao: Quan ly tai khoan Google -> Bao mat -> Xac minh 2 buoc -> Mat khau ung dung
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-restaurant-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# ------------------------------------------------------------------------------
# 7. CONG DICH VU & GIAO TIEP MICROSERVICES (INTERNAL NETWORKING)
# ------------------------------------------------------------------------------
SERVER_PORT_AUTH=8081
SERVER_PORT_CATALOG=8082
SERVER_PORT_BOOKING=8083

CATALOG_SERVICE_URL=http://localhost:8082
FRONTEND_BASE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 8. CAU HINH URL KHI DEPLOY LEN CLOUD (HEROKU / VERCEL / RAILWAY)
# ------------------------------------------------------------------------------
# Khi deploy Frontend len Vercel/Netlify, dien URL backend that (bo trong khi chay local):
# VITE_AUTH_API_URL=https://bepviet-auth-service.up.railway.app/api/v1
# VITE_CATALOG_API_URL=https://bepviet-catalog-service.up.railway.app/api/v1
# VITE_ORDER_API_URL=https://bepviet-booking-service.up.railway.app/api/v1
