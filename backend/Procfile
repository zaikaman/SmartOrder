# Heroku Process Definitions
web: java -Dserver.port=$PORT -jar $APP_JAR
auth: java -Dserver.port=$PORT -jar auth-user-service/target/auth-user-service-1.0.0.jar
catalog: java -Dserver.port=$PORT -jar catalog-table-service/target/catalog-table-service-1.0.0.jar
booking: java -Dserver.port=$PORT -jar booking-order-service/target/booking-order-service-1.0.0.jar
